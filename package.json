{
  "name": "i-love-free-compressor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Free image tools with optional private accounts",
  "scripts": {
    "deploy:production": "node scripts/deploy-production.mjs",
    "start": "python3 -m http.server 4173 --bind 127.0.0.1 --directory public",
    "test": "node tests/browser.mjs",
    "package": "python3 scripts/package.py",
    "build:auth": "node scripts/build-auth.mjs",
    "test:accounts": "node tests/accounts-db.mjs && node tests/account-deletion.mjs && node tests/account-config.mjs",
    "test:account-ui": "node tests/accounts-browser.mjs",
    "build:presentations": "node scripts/build-presentations.mjs",
    "test:presentations": "node tests/presentations-browser.mjs",
    "build:tools": "node scripts/build-tools.mjs",
    "test:utilities": "node tests/utilities-browser.mjs",
    "test:studio": "node tests/studio-browser.mjs",
    "test:help": "node tests/help-browser.mjs",
    "test:videos": "node tests/videos-browser.mjs",
    "capture:demos": "node scripts/capture-demos.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "jsqr": "1.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
